{
  "name": "ai-quantization-laboratory",
  "private": true,
  "version": "1.0.0",
  "description": "Interactive, offline-capable laboratory for exploring numerical formats, quantization, and their effect on matrix arithmetic and miniature neural networks.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:numerics": "vitest run --project unit tests/numerics",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fixtures": "python3 -I scripts/generate_reference_fixtures.py"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "fast-check": "^4.10.2",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
